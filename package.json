{
  "name": "devu-utils",
  "version": "1.1.4",
  "description": "Repository setup utilities for license files and semantic-release.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "devu": "./dist/cli/develop-utils.js",
    "develop-utils": "./dist/cli/develop-utils.js",
    "add-licenses": "./dist/cli/add-licenses.js",
    "add-semantic-release": "./dist/cli/add-semantic-release.js"
  },
  "files": [
    "dist/",
    "docs/",
    "FEATURE.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test .test-dist/*.test.js",
    "prepack": "npm run build",
    "pack:dry-run": "npm pack --dry-run",
    "release": "semantic-release"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "devu",
    "license",
    "semantic-release",
    "repository",
    "setup",
    "git"
  ],
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^20.19.4",
    "semantic-release": "^25.0.5",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinhnt-ae/develop-utils.git"
  }
}
